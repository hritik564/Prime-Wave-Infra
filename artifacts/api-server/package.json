{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development BLOCKCHAIN_DRY_RUN=true JWT_SECRET=\"${JWT_SECRET:-$SESSION_SECRET}\" && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "build:prod": "pnpm --filter @workspace/prime-wave run build && prisma migrate deploy && prisma generate && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "activate-rds": "node --enable-source-maps ./dist/admin/scripts/rdActivation.mjs",
    "activate-mis": "node --enable-source-maps ./dist/admin/scripts/miActivation.mjs",
    "reconcile-counters": "node --enable-source-maps ./dist/admin/scripts/reconcileCounters.mjs",
    "generate-network": "node --enable-source-maps ./dist/admin/scripts/networkGenerator.mjs",
    "fund-network": "node --enable-source-maps ./dist/admin/scripts/networkFunder.mjs",
    "export-credentials": "node --enable-source-maps ./dist/admin/scripts/credentialExporter.mjs"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.1.0",
    "@prisma/client": "5.22.0",
    "@types/busboy": "^1.5.4",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "viem": "^2.55.2",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "prisma": "5.22.0",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.9"
  }
}