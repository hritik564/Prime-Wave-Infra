generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  REWARD_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
}

enum TransactionType {
  DEPOSIT
  INVESTMENT
  ROI_CLAIM
  PRINCIPAL_RELEASE
  INCOME_TRANSFER
  BINARY_MATCH
  BINARY_ORBIT
  LEVEL_INCOME
  SALARY
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PlanType {
  PLAN_90
  PLAN_180
  PLAN_270
  PLAN_360
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  COMPLETED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  username     String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  referralCode String     @unique

  referredBy String?

  walletAddress String?
  telegramId    String?
  profileImage  String?

  sponsorId       String?
  sponsor         User?  @relation("UserSponsorRelation", fields: [sponsorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReferrals User[] @relation("UserSponsorRelation")

  binaryParentId String?
  binaryParent   User?  @relation("UserBinaryRelation", fields: [binaryParentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  binaryChildren User[] @relation("UserBinaryRelation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet       Wallet?
  adminLogs    AdminLog[]
  transactions WalletTransaction[]
  investments  Investment[]

  @@map("users")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT_ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs AdminLog[]

  @@map("admins")
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  depositWallet    Decimal  @default(0) @db.Decimal(18, 8)
  incomeWallet     Decimal  @default(0) @db.Decimal(18, 8)
  withdrawalWallet Decimal  @default(0) @db.Decimal(18, 8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model AdminLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  details      Json?
  createdAt    DateTime @default(now())

  admin      Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  targetUser User? @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@map("admin_logs")
}

model WalletTransaction {
  id          String            @id @default(cuid())
  walletId    String
  userId      String
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal           @db.Decimal(18, 8)
  fee         Decimal?          @db.Decimal(18, 8)
  netAmount   Decimal?          @db.Decimal(18, 8)
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Investment {
  id                 String           @id @default(cuid())
  userId             String
  amount             Decimal          @db.Decimal(18, 8)
  currentPrincipal   Decimal          @db.Decimal(18, 8)
  planType           PlanType
  dailyROI           Decimal          @db.Decimal(6, 4)
  durationDays       Int
  autoCompound       Boolean          @default(false)
  claimableROI       Decimal          @default(0) @db.Decimal(18, 8)
  claimablePrincipal Decimal          @default(0) @db.Decimal(18, 8)
  status             InvestmentStatus @default(ACTIVE)
  startedAt          DateTime         @default(now())
  maturesAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([planType])
  @@index([maturesAt])
  @@map("investments")
}
