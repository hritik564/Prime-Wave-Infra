generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  REWARD_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
}

enum DepositNetwork {
  BEP20
  ERC20
  TRC20
  SOL
}

enum DepositStatus {
  PENDING
  CONFIRMING
  APPROVED
  REJECTED
}

enum DepositVerificationStatus {
  CREATED
  TX_SUBMITTED
  VERIFYING
  VERIFICATION_DELAYED
  WAITING_CONFIRMATIONS
  CONFIRMED
  CREDITING
  CREDITED
  COMPLETED
  FAILED
  REJECTED
  EXPIRED
}

enum WithdrawalNetwork {
  BEP20
}

enum WithdrawalStatus {
  PENDING
  VALIDATING
  QUEUED
  PROCESSING
  SIGNED
  BROADCASTING
  CONFIRMING
  MANUAL_REVIEW
  APPROVED
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  INVESTMENT
  ROI_CLAIM
  PRINCIPAL_RELEASE
  INCOME_TRANSFER
  BINARY_MATCH
  BINARY_ORBIT
  LEVEL_INCOME
  SALARY
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PlanType {
  PLAN_90
  PLAN_180
  PLAN_270
  PLAN_360
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  COMPLETED
}

enum BinaryPosition {
  LEFT
  RIGHT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  username     String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  referralCode String     @unique

  referredBy          String?
  directReferralCount Int     @default(0)
  directLeftCount     Int     @default(0)
  directRightCount    Int     @default(0)

  // ── Binary tree ───────────────────────────────────────────────────────────
  position              BinaryPosition?
  leftDeepestNodeId     String?
  rightDeepestNodeId    String?
  leftBV                Decimal         @default(0) @db.Decimal(18, 8)
  rightBV               Decimal         @default(0) @db.Decimal(18, 8)

  walletAddress String?
  telegramId    String?
  profileImage  String?

  sponsorId       String?
  sponsor         User?  @relation("UserSponsorRelation", fields: [sponsorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReferrals User[] @relation("UserSponsorRelation")

  binaryParentId String?
  binaryParent   User?  @relation("UserBinaryRelation", fields: [binaryParentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  binaryChildren User[] @relation("UserBinaryRelation")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isTestUser Boolean  @default(false)

  wallet           Wallet?
  adminLogs        AdminLog[]
  transactions     WalletTransaction[]
  investments      Investment[]
  roiLedger        RoiLedger[]
  referralHistory  ReferralHistory?  @relation("ReferralHistoryUser")
  givenReferrals   ReferralHistory[] @relation("ReferralHistorySponsor")

  binaryMatchIncome BinaryMatchIncome[]
  binaryOrbitIncome BinaryOrbitIncome[]

  // Level income — records where this user RECEIVES income from downline investments
  levelIncomeReceived LevelIncome[] @relation("LevelIncomeReceiver")
  // Level income — records where this user's investment TRIGGERED income for upline
  levelIncomeSource   LevelIncome[] @relation("LevelIncomeSource")

  // Salary
  salaryAchievements SalaryAchievement[]
  salaryIncome       SalaryIncome[]

  // Deposits
  depositRequests    DepositRequest[]

  // Withdrawals
  withdrawalRequests WithdrawalRequest[]

  // BV ledger relations (as ancestor — BV flows into this user's legs)
  matchBvEntries   MatchBvLedger[]  @relation("MatchBvAncestor")
  orbitBvEntries   OrbitBvLedger[]  @relation("OrbitBvAncestor")
  salaryBvEntries  SalaryBvLedger[] @relation("SalaryBvAncestor")
  bvHistory        BvHistory[]      @relation("BvHistoryAncestor")

  // BV ledger relations (as investor — this user's investments generate BV)
  matchBvInvested   MatchBvLedger[]  @relation("MatchBvInvestor")
  orbitBvInvested   OrbitBvLedger[]  @relation("OrbitBvInvestor")
  salaryBvInvested  SalaryBvLedger[] @relation("SalaryBvInvestor")
  bvHistoryInvested BvHistory[]      @relation("BvHistoryInvestor")

  notifications        Notification[]
  incomeTransfers      IncomeTransfer[]
  depositVerifications DepositVerification[]
  walletAddresses      WalletAddress[]

  @@map("users")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT_ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs             AdminLog[]
  approvedDeposits DepositRequest[]

  approvedWithdrawals  WithdrawalRequest[] @relation("WithdrawalApprover")
  completedWithdrawals WithdrawalRequest[] @relation("WithdrawalCompleter")

  @@map("admins")
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  depositWallet           Decimal  @default(0) @db.Decimal(18, 8)
  incomeWallet            Decimal  @default(0) @db.Decimal(18, 8)
  withdrawalWallet        Decimal  @default(0) @db.Decimal(18, 8)
  lockedWithdrawalBalance Decimal  @default(0) @db.Decimal(18, 8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model AdminLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  details      Json?
  createdAt    DateTime @default(now())

  admin      Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  targetUser User? @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@map("admin_logs")
}

model WalletTransaction {
  id              String            @id @default(cuid())
  walletId        String
  userId          String
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(18, 8)
  fee             Decimal?          @db.Decimal(18, 8)
  netAmount       Decimal?          @db.Decimal(18, 8)
  description     String?
  // DB-level idempotency guard: only one wallet transaction may ever be created
  // for a given deposit. PostgreSQL rejects any duplicate insert immediately,
  // even if application-level guards somehow fail simultaneously.
  sourceDepositId String?           @unique @map("source_deposit_id")
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Investment {
  id                 String           @id @default(cuid())
  userId             String
  amount             Decimal          @db.Decimal(18, 8)
  currentPrincipal   Decimal          @db.Decimal(18, 8)
  planType           PlanType
  dailyROI           Decimal          @db.Decimal(6, 4)
  durationDays       Int
  autoCompound       Boolean          @default(false)
  claimableROI       Decimal          @default(0) @db.Decimal(18, 8)
  claimablePrincipal Decimal          @default(0) @db.Decimal(18, 8)
  status             InvestmentStatus @default(ACTIVE)
  startedAt          DateTime         @default(now())
  maturesAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  roiLedger RoiLedger[]

  matchBvLedger  MatchBvLedger[]
  orbitBvLedger  OrbitBvLedger[]
  salaryBvLedger SalaryBvLedger[]
  bvHistory      BvHistory[]
  levelIncome    LevelIncome[]

  @@index([userId])
  @@index([status])
  @@index([planType])
  @@index([maturesAt])
  @@map("investments")
}

model RoiLedger {
  id            String   @id @default(cuid())
  userId        String
  investmentId  String
  amount        Decimal  @db.Decimal(18, 8)
  cycleNumber   Int
  wasCompounded Boolean  @default(false)
  wasClaimed    Boolean  @default(false)
  createdAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([investmentId])
  @@index([userId])
  @@index([wasCompounded])
  @@index([wasClaimed])
  @@map("roi_ledger")
}

model ReferralHistory {
  id        String          @id @default(cuid())
  sponsorId String
  userId    String          @unique
  leg       BinaryPosition?
  createdAt DateTime        @default(now())

  sponsor User @relation("ReferralHistorySponsor", fields: [sponsorId], references: [id], onDelete: Restrict)
  user    User @relation("ReferralHistoryUser",    fields: [userId],    references: [id], onDelete: Restrict)

  @@index([sponsorId])
  @@map("referral_history")
}

// ── BV Ledgers ────────────────────────────────────────────────────────────────
//
// One entry per ancestor per investment.
//   userId       = ancestor whose leg BV is credited to
//   investorId   = the user whose investment triggered the BV
//   investmentId = the specific investment
//   bv           = whole BV units credited (1 BV = $100)
//   side         = which leg of userId received the BV
//   depth        = 1 for direct parent, 2 for grandparent, etc.
//
// Three separate tables let income engines consume them independently
// (matching, orbit, salary may diverge in future sprint rules).

model MatchBvLedger {
  id           String         @id @default(cuid())
  userId       String
  investorId   String
  investmentId String
  bv           Decimal        @db.Decimal(18, 8)
  side         BinaryPosition
  depth        Int
  createdAt    DateTime       @default(now())

  user       User       @relation("MatchBvAncestor", fields: [userId],       references: [id], onDelete: Restrict)
  investor   User       @relation("MatchBvInvestor", fields: [investorId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([investorId])
  @@index([investmentId])
  @@index([createdAt])
  @@map("match_bv_ledger")
}

model OrbitBvLedger {
  id           String         @id @default(cuid())
  userId       String
  investorId   String
  investmentId String
  bv           Decimal        @db.Decimal(18, 8)
  side         BinaryPosition
  depth        Int
  createdAt    DateTime       @default(now())

  user       User       @relation("OrbitBvAncestor", fields: [userId],       references: [id], onDelete: Restrict)
  investor   User       @relation("OrbitBvInvestor", fields: [investorId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([investorId])
  @@index([investmentId])
  @@index([createdAt])
  @@map("orbit_bv_ledger")
}

model SalaryBvLedger {
  id           String         @id @default(cuid())
  userId       String
  investorId   String
  investmentId String
  bv           Decimal        @db.Decimal(18, 8)
  side         BinaryPosition
  depth        Int
  createdAt    DateTime       @default(now())

  user       User       @relation("SalaryBvAncestor", fields: [userId],       references: [id], onDelete: Restrict)
  investor   User       @relation("SalaryBvInvestor", fields: [investorId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([investorId])
  @@index([investmentId])
  @@index([createdAt])
  @@map("salary_bv_ledger")
}

// ── Binary Matching Income ────────────────────────────────────────────────────
//
// One record per qualifying user per cron cycle (00:00 and 12:00 Europe/London).
// Qualification: directReferralCount >= 2, matchedBV > 0.
//
//   matchedBV    = min(leftBV, rightBV)          — BV consumed from both legs
//   payableBV    = min(matchedBV, 50)             — capped at 50 BV per cycle
//   destroyedBV  = matchedBV - payableBV          — excess matched BV, discarded
//   incomeAmount = payableBV × $5                 — credited to withdrawalWallet
//   cycleStart/cycleEnd                           — 12-hour window boundaries

model BinaryMatchIncome {
  id                String   @id @default(cuid())
  userId            String
  matchedBV         Decimal  @db.Decimal(18, 8)
  payableBV         Decimal  @db.Decimal(18, 8)
  destroyedBV       Decimal  @db.Decimal(18, 8)
  flushedBV         Decimal  @default(0) @db.Decimal(18, 8)
  carryForwardLeft  Decimal  @default(0) @db.Decimal(18, 8)
  carryForwardRight Decimal  @default(0) @db.Decimal(18, 8)
  incomeAmount      Decimal  @db.Decimal(18, 8)
  cycleStart        DateTime
  cycleEnd          DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([cycleStart])
  @@index([createdAt])
  @@map("binary_match_income")
}

// ── Unified BV audit trail ────────────────────────────────────────────────────

model BvHistory {
  id           String         @id @default(cuid())
  userId       String
  investorId   String
  investmentId String
  bv           Decimal        @db.Decimal(18, 8)
  side         BinaryPosition
  depth        Int
  createdAt    DateTime       @default(now())

  user       User       @relation("BvHistoryAncestor", fields: [userId],       references: [id], onDelete: Restrict)
  investor   User       @relation("BvHistoryInvestor", fields: [investorId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([investorId])
  @@index([investmentId])
  @@index([createdAt])
  @@map("bv_history")
}

// ── Binary Orbit Income ───────────────────────────────────────────────────────
//
// One record per qualifying user per cron cycle (00:00 and 12:00 Europe/London).
// Qualification: directReferralCount >= 2, rewardCount > 0.
//
//   matchedBV           = min(leftBV, rightBV)
//   rewardCount         = floor(matchedBV / bvPerReward)   — full orbit rewards earned
//   payableRewardCount  = min(rewardCount, maxPerCycle)    — capped at 1 per cycle (from SystemSettings)
//   destroyedRewardCount= rewardCount - payableRewardCount — excess orbits, discarded
//   incomeAmount        = payableRewardCount × $500        — credited to withdrawalWallet
//   consumedBV          = rewardCount × bvPerReward        — removed from each leg

model BinaryOrbitIncome {
  id                   String   @id @default(cuid())
  userId               String
  matchedBV            Decimal  @db.Decimal(18, 8)
  rewardCount          Int
  destroyedRewardCount Int
  flushedBV            Decimal  @default(0) @db.Decimal(18, 8)
  carryForwardLeft     Decimal  @default(0) @db.Decimal(18, 8)
  carryForwardRight    Decimal  @default(0) @db.Decimal(18, 8)
  incomeAmount         Decimal  @db.Decimal(18, 8)
  cycleStart           DateTime
  cycleEnd             DateTime
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([cycleStart])
  @@index([createdAt])
  @@map("binary_orbit_income")
}

// ── System Settings ───────────────────────────────────────────────────────────
//
// Key-value store for runtime-configurable payout parameters.
// Admins can update values via the database without a code deployment.
//
// Canonical keys (seeded in migration):
//   orbit.bv_per_reward          — BV required per orbit reward unit   (default: 150)
//   orbit.max_rewards_per_cycle  — Max orbit rewards paid per cycle     (default: 1)
//   orbit.income_per_reward      — USD payout per orbit reward          (default: 500)
//   orbit.min_referrals          — Minimum direct referrals to qualify  (default: 2)
//   matching.max_payable_bv      — Max BV cap per matching cycle        (default: 50)
//   matching.income_per_bv       — USD payout per BV unit matched       (default: 5)
//   matching.min_referrals       — Minimum direct referrals to qualify  (default: 2)

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// ── Level Income ──────────────────────────────────────────────────────────────
//
// Created inline when an investment is made — one record per ancestor level
// that receives a payout (up to 5 levels up the sponsor chain).
//
//   receiverUserId   = sponsor ancestor who receives the income
//   sourceUserId     = investor whose investment triggered the payout
//   level            = 1 (direct sponsor) through 5
//   investmentAmount = gross investment amount used as the percentage base
//   percentage       = percentage applied (stored as 1 = 1%, 2 = 2%, etc.)
//   incomeAmount     = investmentAmount × (percentage / 100)
//   — credited to receiverUser.withdrawalWallet

model LevelIncome {
  id               String   @id @default(cuid())
  receiverUserId   String
  sourceUserId     String
  level            Int
  investmentId     String
  investmentAmount Decimal  @db.Decimal(18, 8)
  percentage       Decimal  @db.Decimal(6, 4)
  incomeAmount     Decimal  @db.Decimal(18, 8)
  createdAt        DateTime @default(now())

  receiver   User       @relation("LevelIncomeReceiver", fields: [receiverUserId], references: [id], onDelete: Restrict)
  source     User       @relation("LevelIncomeSource",   fields: [sourceUserId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([receiverUserId])
  @@index([sourceUserId])
  @@index([investmentId])
  @@index([level])
  @@index([createdAt])
  @@map("level_income")
}

// ── Salary Rank Configuration ─────────────────────────────────────────────────
//
// Seeded once; updated by admins. Controls qualification thresholds and payouts.
//
//   requiresDualDirects  = must have ≥1 personally-sponsored member on each leg
//   allowSpill           = spill BV counts toward requiredBusiness
//   powerLegRequired     = minimum BV the weaker leg must hold (Platinum+)
//   weakLegRequired      = minimum BV the stronger leg must hold (Platinum+)

model SalaryRankConfig {
  id               String   @id @default(cuid())
  rankName         String   @unique
  requiredBusiness Decimal  @db.Decimal(18, 2)
  monthlySalary    Decimal  @db.Decimal(18, 2)
  durationMonths   Int
  requiresDualDirects Boolean @default(false)
  allowSpill          Boolean @default(false)
  powerLegRequired Decimal? @db.Decimal(18, 2)
  weakLegRequired  Decimal? @db.Decimal(18, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  achievements SalaryAchievement[]

  @@map("salary_rank_config")
}

// ── Salary Achievement ────────────────────────────────────────────────────────
//
// Cumulative Milestone Model (Sprint 23F):
//   • One record per user per rank — created once when the rank is first earned.
//   • A member may hold multiple ACTIVE achievements simultaneously
//     (Bronze + Silver + Gold are all valid at the same time).
//   • Earning a higher rank NEVER deactivates lower-rank achievements.
//   • isActive → false when paymentsMade reaches durationMonths, or expiresAt passes.
//
// Payment tracking:
//   paymentsMade  — incremented by the salary cron after each successful payment
//   lastPaidAt    — timestamp of the most recent payment (set by the cron)

model SalaryAchievement {
  id            String    @id @default(cuid())
  userId        String
  rankName      String
  achievedAt    DateTime  @default(now())
  expiresAt     DateTime
  monthlyAmount Decimal   @db.Decimal(18, 2)
  isActive      Boolean   @default(true)
  paymentsMade  Int       @default(0)
  lastPaidAt    DateTime?
  createdAt     DateTime  @default(now())

  user   User             @relation(fields: [userId],   references: [id], onDelete: Restrict)
  config SalaryRankConfig @relation(fields: [rankName], references: [rankName], onDelete: Restrict)

  @@unique([userId, rankName])
  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("salary_achievement")
}

// ── Salary Income ─────────────────────────────────────────────────────────────
//
// One record per user per rank per month.
// Idempotency key: (userId, rankName, month, year).

model SalaryIncome {
  id       String   @id @default(cuid())
  userId   String
  rankName String
  month    Int
  year     Int
  amount   Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, rankName, month, year])
  @@index([userId])
  @@index([year, month])
  @@index([createdAt])
  @@map("salary_income")
}

// ── Company Wallets ───────────────────────────────────────────────────────────
//
// Managed by admins. Shown to users during deposit submission so they know
// which on-chain address to send funds to for each network.

model CompanyWallet {
  id            String         @id @default(cuid())
  network       DepositNetwork
  walletAddress String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  @@unique([network, walletAddress])
  @@index([network])
  @@index([isActive])
  @@map("company_wallets")
}

// ── Deposit Requests ──────────────────────────────────────────────────────────
//
// Submitted by users after sending crypto manually.
// Admin approves → credit depositWallet; or rejects with a reason.
//
//   minimumDeposit   = (approvedDepositCount + 1) × 100
//   amount           = must be a multiple of $100, ≥ minimumDeposit
//   txHash           = on-chain transaction hash (unique)
//   companyWallet    = address the user was shown / sent funds to
//   screenshotUrl    = optional proof of payment screenshot

model DepositRequest {
  id               String         @id @default(cuid())
  userId           String
  amount           Decimal        @db.Decimal(18, 2)
  network          DepositNetwork
  txHash           String         @unique
  screenshotUrl    String?
  companyWallet    String
  status           DepositStatus  @default(PENDING)
  approvedByAdminId String?
  approvedAt       DateTime?
  rejectedReason   String?
  createdAt        DateTime       @default(now())

  user         User                @relation(fields: [userId],            references: [id], onDelete: Restrict)
  approver     Admin?              @relation(fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  verification DepositVerification?

  @@index([userId])
  @@index([status])
  @@index([network])
  @@index([txHash])
  @@index([createdAt])
  @@map("deposit_requests")
}

// ── Withdrawal Settings ───────────────────────────────────────────────────────
//
// One row per network; configurable via DB without a code deploy.
// Seeded with BEP20 defaults: min=$10, max=$2500, enabled=true.

model WithdrawalSettings {
  id            String            @id @default(cuid())
  network       WithdrawalNetwork @unique
  minimumAmount Decimal           @db.Decimal(18, 8)
  maximumAmount Decimal           @db.Decimal(18, 8)
  feePercentage Decimal           @default(0) @db.Decimal(5, 4)
  isEnabled     Boolean           @default(true)
  updatedAt     DateTime          @updatedAt

  @@map("withdrawal_settings")
}

// ── Withdrawal Requests ───────────────────────────────────────────────────────
//
// User submits a request to withdraw from withdrawalWallet.
// Funds are locked immediately (wallets.lockedWithdrawalBalance += amount,
//   wallets.withdrawalWallet -= amount).
//
// Flow:  PENDING → VALIDATING → QUEUED → PROCESSING → BROADCASTING → CONFIRMING → COMPLETED
//        PENDING → CANCELLED  (user-initiated, auto-refund)
//        PENDING/APPROVED → REJECTED  (admin, auto-refund)
//        Any pre-COMPLETED state → FAILED (system, auto-refund)
//        APPROVED (legacy admin-approve) → COMPLETED (txHash required)

model WithdrawalRequest {
  id                      String            @id @default(cuid())
  seqId                   Int               @default(autoincrement())
  withdrawalId            String?           @unique
  idempotencyKey          String            @unique @default(uuid())
  userId                  String
  currency                String            @default("USDT")
  amount                  Decimal           @db.Decimal(18, 8)
  fee                     Decimal           @default(0) @db.Decimal(18, 8)
  netAmount               Decimal           @db.Decimal(18, 8)
  walletAddress           String
  walletAddressSnapshot   String
  network                 WithdrawalNetwork
  status                  WithdrawalStatus  @default(PENDING)
  approvedByAdminId       String?
  completedByAdminId      String?
  txHash                  String?           @unique
  failureReason           String?
  rejectedReason          String?
  adminNotes              String?
  preparedTxData          Json?
  broadcastAt             DateTime?
  signedAt                DateTime?
  requestedAt             DateTime          @default(now())
  processedAt             DateTime?
  cancelledAt             DateTime?
  approvedAt              DateTime?
  completedAt             DateTime?
  confirmationBlock       Int?
  confirmationCount       Int?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user      User   @relation(fields: [userId],             references: [id], onDelete: Restrict)
  approver  Admin? @relation("WithdrawalApprover",  fields: [approvedByAdminId],  references: [id], onDelete: SetNull)
  completer Admin? @relation("WithdrawalCompleter", fields: [completedByAdminId], references: [id], onDelete: SetNull)
  events    WithdrawalEvent[]

  @@index([userId])
  @@index([status])
  @@index([network])
  @@index([createdAt])
  @@map("withdrawal_requests")
}

// ── Withdrawal Event Log ───────────────────────────────────────────────────────
//
// Append-only timeline of state transitions and notable events for each
// withdrawal request.  Used by admin UI to show a full audit trail.
//
// eventType examples: CREATED, VALIDATED, QUEUED, PROCESSING, SIGNED,
//   BROADCAST, CONFIRMING, CONFIRMED, COMPLETED, FAILED, REFUNDED,
//   MANUAL_REVIEW, RECOVERY_SCAN, CONFIRMATION_POLL

model WithdrawalEvent {
  id           String   @id @default(cuid())
  withdrawalId String
  eventType    String
  details      Json?
  createdAt    DateTime @default(now())

  withdrawal WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId])
  @@index([createdAt])
  @@map("withdrawal_events")
}

model WalletAddress {
  id         String            @id @default(cuid())
  userId     String
  network    WithdrawalNetwork
  address    String
  label      String?
  isVerified Boolean           @default(true)
  isPrimary  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, network, address])
  @@index([userId])
  @@index([network])
  @@map("wallet_addresses")
}

// ── Job Execution Log ─────────────────────────────────────────────────────────

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

model JobExecutionLog {
  id               String    @id @default(cuid())
  jobName          String
  startedAt        DateTime
  completedAt      DateTime?
  status           JobStatus
  recordsProcessed Int?
  errorMessage     String?
  createdAt        DateTime  @default(now())

  @@index([jobName])
  @@index([status])
  @@index([createdAt])
  @@map("job_execution_logs")
}

// ── Notifications ─────────────────────────────────────────────────────────────

enum NotificationType {
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  DEPOSIT_VERIFICATION_DELAYED
  DEPOSIT_FAILED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_REJECTED
  INVESTMENT_CREATED
  ROI_CLAIMED
  PRINCIPAL_RELEASED
  BINARY_MATCH_INCOME
  BINARY_ORBIT_INCOME
  LEVEL_INCOME
  SALARY_RECEIVED
  RANK_ACHIEVED
  PASSWORD_CHANGED
  WALLET_CHANGED
  ACCOUNT_BLOCKED
  ACCOUNT_SUSPENDED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ── Income Transfer Engine ────────────────────────────────────────────────────
//
// When a user requests an income→withdrawal transfer:
//   1. A one-time 15% transfer fee is deducted from the original amount.
//   2. The remaining 85% (netAmount) enters the 72-hour release queue.
//   3. Every hour, 1/72 of netAmount is credited to the withdrawalWallet.
//   4. After 72 releases: total released == netAmount (fee never enters engine).
//
// Legacy records (before fee was introduced) have transferFee/netAmount = null;
// treat those as fee=0, netAmount=totalAmount.
//
// Status lifecycle:  ACTIVE → COMPLETED (after 72 hourly releases)

enum IncomeTransferStatus {
  ACTIVE
  COMPLETED
}

model IncomeTransfer {
  id              String               @id @default(cuid())
  userId          String
  totalAmount     Decimal              @db.Decimal(18, 8)  // original user input
  transferFee     Decimal?             @db.Decimal(18, 8)  // 15% fee (null = legacy record)
  netAmount       Decimal?             @db.Decimal(18, 8)  // 85% net entering engine (null = legacy)
  releasedAmount  Decimal              @default(0) @db.Decimal(18, 8)
  remainingAmount Decimal              @db.Decimal(18, 8)  // tracks remaining of netAmount
  hourlySlice     Decimal              @db.Decimal(18, 8)  // netAmount / 72
  hoursCompleted  Int                  @default(0)
  status          IncomeTransferStatus @default(ACTIVE)
  nextReleaseAt   DateTime
  createdAt       DateTime             @default(now())
  completedAt     DateTime?

  user     User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  releases IncomeTransferRelease[]

  @@index([userId])
  @@index([status])
  @@index([nextReleaseAt])
  @@map("income_transfers")
}

// ── Deposit Verification ──────────────────────────────────────────────────────
//
// Blockchain audit trail for automatically-verified USDT deposits.
// One record per submitted transaction hash.
//
// State machine:
//   CREATED → TX_SUBMITTED → VERIFYING → WAITING_CONFIRMATIONS
//           → CONFIRMED → CREDITED → COMPLETED
//   (Failure paths: FAILED | REJECTED | EXPIRED)
//
// The worker queries verificationStatus IN (VERIFYING, WAITING_CONFIRMATIONS)
// AND nextCheckAt <= NOW() — restart-safe, no in-memory job state.
//
// depositId is NULL until blockchain confirms and a DepositRequest is created.
// The wallet credit reuses approveDeposit() — identical pipeline to manual flow.

model DepositVerification {
  id                    String                    @id @default(cuid())
  userId                String
  depositId             String?                   @unique
  txHash                String                    @unique
  network               DepositNetwork
  senderAddress         String?
  recipientAddress      String
  tokenContract         String?
  blockchainAmount      Decimal?                  @db.Decimal(18, 8)
  confirmations         Int                       @default(0)
  requiredConfirmations Int                       @default(12)
  verificationStatus    DepositVerificationStatus @default(CREATED)
  verificationAttempts  Int                       @default(0)
  lastCheckedAt         DateTime?
  nextCheckAt           DateTime?
  firstSeenAt           DateTime?
  confirmedAt           DateTime?
  creditedAt            DateTime?
  completedAt           DateTime?
  failureReason         String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user    User            @relation(fields: [userId],    references: [id], onDelete: Restrict)
  deposit DepositRequest? @relation(fields: [depositId], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
  @@index([userId])
  @@index([txHash])
  @@index([nextCheckAt])
  @@index([createdAt])
  @@map("deposit_verifications")
}

// One record per hourly release fired by the transfer cron engine.
model IncomeTransferRelease {
  id         String   @id @default(cuid())
  transferId String
  hourNumber Int
  amount     Decimal  @db.Decimal(18, 8)
  createdAt  DateTime @default(now())

  transfer IncomeTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@map("income_transfer_releases")
}
