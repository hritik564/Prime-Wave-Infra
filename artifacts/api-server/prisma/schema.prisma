// ── Income Transfer Engine ────────────────────────────────────────────────────
//
// When a user requests an income→withdrawal transfer:
//   1. A one-time 15% transfer fee is deducted from the original amount.
//   2. The remaining 85% (netAmount) enters the 72-hour release queue.
//   3. Every hour, 1/72 of netAmount is credited to the withdrawalWallet.
//   4. After 72 releases: total released == netAmount (fee never enters engine).
//
// Legacy records (before fee was introduced) have transferFee/netAmount = null;
// treat those as fee=0, netAmount=totalAmount.
//
// Status lifecycle:  ACTIVE → COMPLETED (after 72 hourly releases)

enum IncomeTransferStatus {
  ACTIVE
  COMPLETED
}

model IncomeTransfer {
  id              String               @id @default(cuid())
  userId          String
  totalAmount     Decimal              @db.Decimal(18, 8)  // original user input
  transferFee     Decimal?             @db.Decimal(18, 8)  // 15% fee (null = legacy record)
  netAmount       Decimal?             @db.Decimal(18, 8)  // 85% net entering engine (null = legacy)
  releasedAmount  Decimal              @default(0) @db.Decimal(18, 8)
  remainingAmount Decimal              @db.Decimal(18, 8)  // tracks remaining of netAmount
  hourlySlice     Decimal              @db.Decimal(18, 8)  // netAmount / 72
  hoursCompleted  Int                  @default(0)
  status          IncomeTransferStatus @default(ACTIVE)
  nextReleaseAt   DateTime
  createdAt       DateTime             @default(now())
  completedAt     DateTime?

  user     User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  releases IncomeTransferRelease[]

  @@index([userId])
  @@index([status])
  @@index([nextReleaseAt])
  @@map("income_transfers")
}

// ── Deposit Verification ──────────────────────────────────────────────────────
//
// Blockchain audit trail for automatically-verified USDT deposits.
// One record per submitted transaction hash.
//
// State machine:
//   CREATED → TX_SUBMITTED → VERIFYING → WAITING_CONFIRMATIONS
//           → CONFIRMED → CREDITED → COMPLETED
//   (Failure paths: FAILED | REJECTED | EXPIRED)
//
// The worker queries verificationStatus IN (VERIFYING, WAITING_CONFIRMATIONS)
// AND nextCheckAt <= NOW() — restart-safe, no in-memory job state.
//
// depositId is NULL until blockchain confirms and a DepositRequest is created.
// The wallet credit reuses approveDeposit() — identical pipeline to manual flow.

model DepositVerification {
  id                    String                    @id @default(cuid())
  userId                String
  depositId             String?                   @unique
  txHash                String                    @unique
  network               DepositNetwork
  senderAddress         String?
  recipientAddress      String
  tokenContract         String?
  blockchainAmount      Decimal?                  @db.Decimal(18, 8)
  confirmations         Int                       @default(0)
  requiredConfirmations Int                       @default(12)
  verificationStatus    DepositVerificationStatus @default(CREATED)
  verificationAttempts  Int                       @default(0)
  lastCheckedAt         DateTime?
  nextCheckAt           DateTime?
  firstSeenAt           DateTime?
  confirmedAt           DateTime?
  creditedAt            DateTime?
  completedAt           DateTime?
  failureReason         String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  user    User            @relation(fields: [userId],    references: [id], onDelete: Restrict)
  deposit DepositRequest? @relation(fields: [depositId], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
  @@index([userId])
  @@index([txHash])
  @@index([nextCheckAt])
  @@index([createdAt])
  @@map("deposit_verifications")
}

// One record per hourly release fired by the transfer cron engine.
model IncomeTransferRelease {
  id         String   @id @default(cuid())
  transferId String
  hourNumber Int
  amount     Decimal  @db.Decimal(18, 8)
  createdAt  DateTime @default(now())

  transfer IncomeTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@map("income_transfer_releases")
}

// ─── Financial Ledger (Sprint 31F) ────────────────────────────────────────────

enum LedgerTransactionType {
  DEPOSIT
  INVESTMENT
  ROI
  LEVEL_INCOME
  MATCHING_BONUS
  ORBIT_INCOME
  SALARY_INCOME
  TRANSFER_OUT
  TRANSFER_IN
  WITHDRAWAL_REQUEST
  WITHDRAWAL_BROADCAST
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_REFUND
  WITHDRAWAL_CANCELLATION
  MANUAL_ADJUSTMENT
  POWER_BV_RECOVERY
}

enum DebitCredit {
  DEBIT
  CREDIT
}

enum LedgerWalletType {
  DEPOSIT_WALLET
  INCOME_WALLET
  WITHDRAWAL_WALLET
  LOCKED_BALANCE
}

enum DiscrepancySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DiscrepancyStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

/// Immutable append-only financial ledger. Entries must never be edited or deleted.
/// Corrections are recorded as separate reversing entries (MANUAL_ADJUSTMENT).
model FinancialLedger {
  id               String                @id @default(cuid())
  referenceId      String
  referenceType    String
  memberId         String
  username         String
  transactionType  LedgerTransactionType
  amount           Decimal               @db.Decimal(18, 8)
  currency         String                @default("USDT")
  debitCredit      DebitCredit
  walletType       LedgerWalletType
  openingBalance   Decimal               @db.Decimal(18, 8)
  closingBalance   Decimal               @db.Decimal(18, 8)
  blockchainTxHash String?
  withdrawalId     String?
  investmentId     String?
  metadata         Json?
  createdAt        DateTime              @default(now())

  @@index([memberId])
  @@index([referenceId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([withdrawalId])
  @@index([blockchainTxHash])
  @@map("financial_ledger")
}

/// Discrepancies detected by the reconciliation engine.
model FinancialDiscrepancy {
  id              String              @id @default(cuid())
  type            String
  severity        DiscrepancySeverity
  description     String
  detectedAt      DateTime            @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?
  status          DiscrepancyStatus   @default(OPEN)
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([severity])
  @@index([detectedAt])
  @@map("financial_discrepancies")
}

/// Saved reconciliation run results.
model ReconciliationReport {
  id               String   @id @default(cuid())
  runAt            DateTime @default(now())
  status           String
  summary          Json
  discrepancyCount Int      @default(0)
  isManual         Boolean  @default(false)
  triggeredBy      String?
  createdAt        DateTime @default(now())

  @@index([runAt])
  @@map("reconciliation_reports")
}

/// Immutable audit trail for every admin-initiated withdrawal wallet address change.
/// Denormalised on write — never updated, never deleted.
model WalletChangeAuditLog {
  id             String   @id @default(cuid())
  adminId        String
  adminUsername  String
  userId         String
  userUsername   String
  previousWallet String?
  newWallet      String
  reason         String
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
  @@map("wallet_change_audit_logs")
}

/// Immutable audit trail for every Power BV change.
/// Never update, never delete — one row per operation.
model PowerBvLedger {
  id            String           @id @default(cuid())
  userId        String
  adminId       String
  side          BinaryPosition
  operation     PowerBvOperation
  bv            Decimal          @db.Decimal(18, 8)
  balanceBefore Decimal          @db.Decimal(18, 8)
  balanceAfter  Decimal          @db.Decimal(18, 8)
  reason        String
  metadata      Json?
  createdAt     DateTime         @default(now())

  user  User  @relation(fields: [userId],  references: [id], onDelete: Restrict)
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
  @@map("power_bv_ledger")
}

