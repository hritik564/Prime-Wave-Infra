generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  REWARD_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  username     String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  referralCode String     @unique

  // Kept for backward compatibility (Sprint 1 plain string)
  referredBy String?

  // New optional fields (Sprint 2 schema improvements)
  walletAddress String?
  telegramId    String?
  profileImage  String?

  // Sponsor / upline self-relation
  sponsorId       String?
  sponsor         User?  @relation("UserSponsorRelation", fields: [sponsorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReferrals User[] @relation("UserSponsorRelation")

  // Binary tree self-relation
  binaryParentId String?
  binaryParent   User?  @relation("UserBinaryRelation", fields: [binaryParentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  binaryChildren User[] @relation("UserBinaryRelation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet    Wallet?
  adminLogs AdminLog[]

  @@map("users")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT_ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs AdminLog[]

  @@map("admins")
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  depositWallet    Decimal  @default(0) @db.Decimal(18, 8)
  incomeWallet     Decimal  @default(0) @db.Decimal(18, 8)
  withdrawalWallet Decimal  @default(0) @db.Decimal(18, 8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model AdminLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  details      Json?
  createdAt    DateTime @default(now())

  admin      Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  targetUser User? @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@map("admin_logs")
}
