generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  REWARD_MANAGER
  STAFF_OPERATIONS
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
}

enum DepositNetwork {
  BEP20
  ERC20
  TRC20
  SOL
}

enum DepositStatus {
  PENDING
  CONFIRMING
  APPROVED
  REJECTED
}

enum DepositVerificationStatus {
  CREATED
  TX_SUBMITTED
  VERIFYING
  VERIFICATION_DELAYED
  WAITING_CONFIRMATIONS
  CONFIRMED
  CREDITING
  CREDITED
  COMPLETED
  FAILED
  REJECTED
  EXPIRED
}

enum WithdrawalNetwork {
  BEP20
}

enum WithdrawalStatus {
  PENDING
  VALIDATING
  QUEUED
  PROCESSING
  SIGNED
  BROADCASTING
  BROADCAST_UNKNOWN
  CONFIRMING
  MANUAL_REVIEW
  UNDER_REVIEW
  APPROVED
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  INVESTMENT
  ROI_CLAIM
  PRINCIPAL_RELEASE
  INCOME_TRANSFER
  BINARY_MATCH
  BINARY_ORBIT
  LEVEL_INCOME
  SALARY
  WITHDRAWAL
  POWER_BV_RECOVERY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PlanType {
  PLAN_90
  PLAN_180
  PLAN_270
  PLAN_360
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  COMPLETED
}

enum BinaryPosition {
  LEFT
  RIGHT
}

enum PowerBvOperation {
  ADD
  REMOVE
}

enum BulkPasswordResetRunStatus {
  PREPARING
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

enum CommonTemporaryPasswordResetRunStatus {
  PREPARING
  RUNNING
  COMPLETED
  FAILED
}

enum CommonTemporaryPasswordResetOperationType {
  COMMON_TEMPORARY_PASSWORD
  FULL_REPLACEMENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  username     String     @unique
  passwordHash String
  passwordResetRequired Boolean  @default(false)
  authVersion          Int      @default(0)
  passwordChangedAt    DateTime?
  fullReplacementPasswordResetRunId String?
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  referralCode String     @unique

  referredBy          String?
  directReferralCount Int     @default(0)
  directLeftCount     Int     @default(0)
  directRightCount    Int     @default(0)

  // ── Binary tree ───────────────────────────────────────────────────────────
  position              BinaryPosition?
  leftDeepestNodeId     String?
  rightDeepestNodeId    String?
  // ── Shared organic BV counters (lifetime; used by salary engine & admin reports)
  // These columns are NEVER flushed by the matching or orbit engines.
  // TODO (later migration): rename to organicLeftBV / organicRightBV once all
  //      callers are audited.
  leftBV                Decimal         @default(0) @db.Decimal(18, 8)
  rightBV               Decimal         @default(0) @db.Decimal(18, 8)
  // Power BV counters (admin-assigned; lifetime; used by salary/admin reports)
  // TODO (later migration): rename to powerOrganicLeftBV / powerOrganicRightBV
  //      once callers are audited.
  powerLeftBV           Decimal         @default(0) @db.Decimal(18, 8)
  powerRightBV          Decimal         @default(0) @db.Decimal(18, 8)

  // ── Independent per-plan BV pools ────────────────────────────────────────
  // Each engine reads and flushes ONLY its own pool.
  // Both pools receive the same BV credit whenever propagateBV or addPowerBV runs.
  matchingLeftBV        Decimal         @default(0) @db.Decimal(18, 8)
  matchingRightBV       Decimal         @default(0) @db.Decimal(18, 8)
  orbitLeftBV           Decimal         @default(0) @db.Decimal(18, 8)
  orbitRightBV          Decimal         @default(0) @db.Decimal(18, 8)

  walletAddress String?
  telegramId    String?
  profileImage  String?

  sponsorId       String?
  sponsor         User?  @relation("UserSponsorRelation", fields: [sponsorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReferrals User[] @relation("UserSponsorRelation")

  binaryParentId String?
  binaryParent   User?  @relation("UserBinaryRelation", fields: [binaryParentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  binaryChildren User[] @relation("UserBinaryRelation")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isTestUser Boolean  @default(false)

  wallet           Wallet?
  passwordResetTokens PasswordResetToken[]
  fullReplacementPasswordResetRun CommonTemporaryPasswordResetRun? @relation("FullReplacementPasswordOwners", fields: [fullReplacementPasswordResetRunId], references: [id], onDelete: SetNull)
  adminLogs              AdminLog[]
  impersonationSessions  ImpersonationSession[]
  transactions           WalletTransaction[]
  investments      Investment[]
  roiLedger        RoiLedger[]
  referralHistory  ReferralHistory?  @relation("ReferralHistoryUser")
  givenReferrals   ReferralHistory[] @relation("ReferralHistorySponsor")

  binaryMatchIncome BinaryMatchIncome[]
  binaryOrbitIncome BinaryOrbitIncome[]

  // Level income — records where this user RECEIVES income from downline investments
  levelIncomeReceived LevelIncome[] @relation("LevelIncomeReceiver")
  // Level income — records where this user's investment TRIGGERED income for upline
  levelIncomeSource   LevelIncome[] @relation("LevelIncomeSource")

  // Salary
  salaryAchievements           SalaryAchievement[]
  salaryIncome                 SalaryIncome[]
  salaryPayoutEvents           SalaryPayoutEvent[]
  salaryBusinessSummary        SalaryBusinessSummary?
  salaryBusinessEvents         SalaryBusinessEvent[] @relation("SalaryBusinessEventUser")
  salaryBusinessEventsAsSource SalaryBusinessEvent[] @relation("SalaryBusinessEventSource")

  // Deposits
  depositRequests    DepositRequest[]

  // Withdrawals
  withdrawalRequests WithdrawalRequest[]

  // BV ledger relations (as ancestor — BV flows into this user's legs)
  matchBvEntries   MatchBvLedger[]  @relation("MatchBvAncestor")
  orbitBvEntries   OrbitBvLedger[]  @relation("OrbitBvAncestor")
  salaryBvEntries  SalaryBvLedger[] @relation("SalaryBvAncestor")
  bvHistory        BvHistory[]      @relation("BvHistoryAncestor")

  // BV ledger relations (as investor — this user's investments generate BV)
  matchBvInvested   MatchBvLedger[]  @relation("MatchBvInvestor")
  orbitBvInvested   OrbitBvLedger[]  @relation("OrbitBvInvestor")
  salaryBvInvested  SalaryBvLedger[] @relation("SalaryBvInvestor")
  bvHistoryInvested BvHistory[]      @relation("BvHistoryInvestor")

  notifications        Notification[]
  incomeTransfers      IncomeTransfer[]
  depositVerifications DepositVerification[]
  walletAddresses      WalletAddress[]
  powerBvLedger        PowerBvLedger[]

  // ── Withdrawal Hold — SUPER_ADMIN controlled ─────────────────────────────
  withdrawalHold       Boolean   @default(false)
  withdrawalHoldReason String?
  withdrawalHoldBy     String?
  withdrawalHoldAt     DateTime?

  @@index([fullReplacementPasswordResetRunId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole @default(SUPPORT_ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs                  AdminLog[]
  bulkPasswordResetRuns BulkPasswordResetRun[]
  commonTemporaryPasswordResetRuns CommonTemporaryPasswordResetRun[]
  impersonationSessions ImpersonationSession[]
  approvedDeposits      DepositRequest[]

  approvedWithdrawals  WithdrawalRequest[] @relation("WithdrawalApprover")
  completedWithdrawals WithdrawalRequest[] @relation("WithdrawalCompleter")
  powerBvLedger        PowerBvLedger[]

  @@map("admins")
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  depositWallet           Decimal  @default(0) @db.Decimal(18, 8)
  incomeWallet            Decimal  @default(0) @db.Decimal(18, 8)
  withdrawalWallet        Decimal  @default(0) @db.Decimal(18, 8)
  lockedWithdrawalBalance Decimal  @default(0) @db.Decimal(18, 8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model AdminLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  details      Json?
  createdAt    DateTime @default(now())

  admin      Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  targetUser User? @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@map("admin_logs")
}

/// Tracks bulk credential-reset progress without ever storing plaintext
/// temporary passwords. The credential artifact lives in private object storage.
model BulkPasswordResetRun {
  id                   String                     @id @default(cuid())
  adminId              String
  status               BulkPasswordResetRunStatus @default(PREPARING)
  totalEligible        Int
  adminCount           Int
  processedCount       Int                      @default(0)
  failedCount          Int                      @default(0)
  lastUserId           String?
  artifactObjectPath   String
  artifactExpiresAt    DateTime
  artifactDownloadedAt DateTime?
  failureReason        String?
  startedAt            DateTime                 @default(now())
  completedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([adminId, createdAt])
  @@map("bulk_password_reset_runs")
}

/// Tracks progress metadata for the common temporary-password control-plane job.
/// The plaintext password is intentionally process-local and is never stored here.
model CommonTemporaryPasswordResetRun {
  id                 String                                  @id @default(cuid())
  adminId            String
  operationType      CommonTemporaryPasswordResetOperationType @default(COMMON_TEMPORARY_PASSWORD)
  status             CommonTemporaryPasswordResetRunStatus @default(PREPARING)
  totalEligible      Int
  adminCount         Int
  processedCount     Int                                  @default(0)
  failedCount        Int                                  @default(0)
  lastUserId         String?
  failureReason      String?
  workerLeaseUntil   DateTime?
  lastHeartbeatAt    DateTime?
  activeLockKey      String?                                @unique
  startedAt          DateTime                               @default(now())
  completedAt        DateTime?
  createdAt          DateTime                               @default(now())
  updatedAt          DateTime                               @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  fullReplacementPasswordOwners User[] @relation("FullReplacementPasswordOwners")

  @@index([status])
  @@index([adminId, createdAt])
  @@map("common_temporary_password_reset_runs")
}

model ImpersonationSession {
  id           String    @id @default(cuid())
  adminId      String
  targetUserId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  ip           String
  userAgent    String
  reason       String?

  admin      Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  targetUser User  @relation(fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([targetUserId])
  @@map("impersonation_sessions")
}

model WalletTransaction {
  id              String            @id @default(cuid())
  walletId        String
  userId          String
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(18, 8)
  fee             Decimal?          @db.Decimal(18, 8)
  netAmount       Decimal?          @db.Decimal(18, 8)
  description     String?
  // DB-level idempotency guard: only one wallet transaction may ever be created
  // for a given deposit. PostgreSQL rejects any duplicate insert immediately,
  // even if application-level guards somehow fail simultaneously.
  sourceDepositId String?           @unique @map("source_deposit_id")
  withdrawalRequestId String?       @unique @map("withdrawal_request_id")
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  withdrawal WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Investment {
  id                 String           @id @default(cuid())
  userId             String
  amount             Decimal          @db.Decimal(18, 8)
  currentPrincipal   Decimal          @db.Decimal(18, 8)
  planType           PlanType
  dailyROI           Decimal          @db.Decimal(6, 4)
  durationDays       Int
  autoCompound       Boolean          @default(false)
  claimableROI       Decimal          @default(0) @db.Decimal(18, 8)
  claimablePrincipal Decimal          @default(0) @db.Decimal(18, 8)
  status             InvestmentStatus @default(ACTIVE)
  startedAt          DateTime         @default(now())
  maturesAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  roiLedger RoiLedger[]

  matchBvLedger  MatchBvLedger[]
  orbitBvLedger  OrbitBvLedger[]
  salaryBvLedger SalaryBvLedger[]
  bvHistory      BvHistory[]
  levelIncome    LevelIncome[]

  @@index([userId])
  @@index([status])
  @@index([planType])
  @@index([maturesAt])
  @@map("investments")
}

model RoiLedger {
  id            String   @id @default(cuid())
  userId        String
  investmentId  String
  amount        Decimal  @db.Decimal(18, 8)
  cycleNumber   Int
  wasCompounded Boolean  @default(false)
  wasClaimed    Boolean  @default(false)
  createdAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([investmentId])
  @@index([userId])
  @@index([wasCompounded])
  @@index([wasClaimed])
  @@map("roi_ledger")
}

model ReferralHistory {
  id        String          @id @default(cuid())
  sponsorId String
  userId    String          @unique
  leg       BinaryPosition?
  createdAt DateTime        @default(now())

  sponsor User @relation("ReferralHistorySponsor", fields: [sponsorId], references: [id], onDelete: Restrict)
  user    User @relation("ReferralHistoryUser",    fields: [userId],    references: [id], onDelete: Restrict)

  @@index([sponsorId])
  @@map("referral_history")
}

// ── BV Ledgers ────────────────────────────────────────────────────────────────
//
// One entry per ancestor per investment.
//   userId       = ancestor whose leg BV is credited to
//   investorId   = the user whose investment triggered the BV
//   investmentId = the specific investment
//   bv           = whole BV units credited (1 BV = $100)
//   side         = which leg of userId received the BV
//   depth        = 1 for direct parent, 2 for grandparent, etc.
//
// Three separate tables let income engines consume them independently
// (matching, orbit, salary may diverge in future sprint rules).

model MatchBvLedger {
  id           String         @id @default(cuid())
  userId       String
  investorId   String
  investmentId String
  bv           Decimal        @db.Decimal(18, 8)
  side         BinaryPosition
  depth        Int
  createdAt    DateTime       @default(now())

  user       User       @relation("MatchBvAncestor", fields: [userId],       references: [id], onDelete: Restrict)
  investor   User       @relation("MatchBvInvestor", fields: [investorId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([investorId])
  @@index([investmentId])
  @@index([createdAt])
  @@map("match_bv_ledger")
}

model OrbitBvLedger {
  id           String         @id @default(cuid())
  userId       String
  investorId   String
  investmentId String
  bv           Decimal        @db.Decimal(18, 8)
  side         BinaryPosition
  depth        Int
  createdAt    DateTime       @default(now())

  user       User       @relation("OrbitBvAncestor", fields: [userId],       references: [id], onDelete: Restrict)
  investor   User       @relation("OrbitBvInvestor", fields: [investorId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([investorId])
  @@index([investmentId])
  @@index([createdAt])
  @@map("orbit_bv_ledger")
}

model SalaryBvLedger {
  id           String         @id @default(cuid())
  userId       String
  investorId   String
  investmentId String
  bv           Decimal        @db.Decimal(18, 8)
  side         BinaryPosition
  depth        Int
  createdAt    DateTime       @default(now())

  user       User       @relation("SalaryBvAncestor", fields: [userId],       references: [id], onDelete: Restrict)
  investor   User       @relation("SalaryBvInvestor", fields: [investorId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([investorId])
  @@index([investmentId])
  @@index([createdAt])
  @@map("salary_bv_ledger")
}

// ── Binary Matching Income ────────────────────────────────────────────────────
//
// One record per qualifying user per cron cycle (00:00 and 12:00 Europe/London).
// Qualification: directReferralCount >= 2, matchedBV > 0.
//
//   matchedBV    = min(leftBV, rightBV)          — BV consumed from both legs
//   payableBV    = min(matchedBV, 50)             — capped at 50 BV per cycle
//   destroyedBV  = matchedBV - payableBV          — excess matched BV, discarded
//   incomeAmount = payableBV × $5                 — credited to withdrawalWallet
//   cycleStart/cycleEnd                           — 12-hour window boundaries

model BinaryMatchIncome {
  id                String   @id @default(cuid())
  userId            String
  matchedBV         Decimal  @db.Decimal(18, 8)
  payableBV         Decimal  @db.Decimal(18, 8)
  destroyedBV       Decimal  @db.Decimal(18, 8)
  flushedBV         Decimal  @default(0) @db.Decimal(18, 8)
  carryForwardLeft  Decimal  @default(0) @db.Decimal(18, 8)
  carryForwardRight Decimal  @default(0) @db.Decimal(18, 8)
  incomeAmount      Decimal  @db.Decimal(18, 8)
  cycleStart        DateTime
  cycleEnd          DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([cycleStart])
  @@index([createdAt])
  @@map("binary_match_income")
}

// ── Unified BV audit trail ────────────────────────────────────────────────────

model BvHistory {
  id           String         @id @default(cuid())
  userId       String
  investorId   String
  investmentId String
  bv           Decimal        @db.Decimal(18, 8)
  side         BinaryPosition
  depth        Int
  createdAt    DateTime       @default(now())

  user       User       @relation("BvHistoryAncestor", fields: [userId],       references: [id], onDelete: Restrict)
  investor   User       @relation("BvHistoryInvestor", fields: [investorId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([investorId])
  @@index([investmentId])
  @@index([createdAt])
  @@map("bv_history")
}

// ── Binary Orbit Income ───────────────────────────────────────────────────────
//
// One record per qualifying user per cron cycle (00:00 and 12:00 Europe/London).
// Qualification: directReferralCount >= 2, rewardCount > 0.
//
//   matchedBV           = min(leftBV, rightBV)
//   rewardCount         = floor(matchedBV / bvPerReward)   — full orbit rewards earned
//   payableRewardCount  = min(rewardCount, maxPerCycle)    — capped at 1 per cycle (from SystemSettings)
//   destroyedRewardCount= rewardCount - payableRewardCount — excess orbits, discarded
//   incomeAmount        = payableRewardCount × $500        — credited to withdrawalWallet
//   consumedBV          = rewardCount × bvPerReward        — removed from each leg

model BinaryOrbitIncome {
  id                   String   @id @default(cuid())
  userId               String
  matchedBV            Decimal  @db.Decimal(18, 8)
  rewardCount          Int
  destroyedRewardCount Int
  flushedBV            Decimal  @default(0) @db.Decimal(18, 8)
  carryForwardLeft     Decimal  @default(0) @db.Decimal(18, 8)
  carryForwardRight    Decimal  @default(0) @db.Decimal(18, 8)
  incomeAmount         Decimal  @db.Decimal(18, 8)
  cycleStart           DateTime
  cycleEnd             DateTime
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([cycleStart])
  @@index([createdAt])
  @@map("binary_orbit_income")
}

// ── System Settings ───────────────────────────────────────────────────────────
//
// Key-value store for runtime-configurable payout parameters.
// Admins can update values via the database without a code deployment.
//
// Canonical keys (seeded in migration):
//   orbit.bv_per_reward          — BV required per orbit reward unit   (default: 150)
//   orbit.max_rewards_per_cycle  — Max orbit rewards paid per cycle     (default: 1)
//   orbit.income_per_reward      — USD payout per orbit reward          (default: 500)
//   orbit.min_referrals          — Minimum direct referrals to qualify  (default: 2)
//   matching.max_payable_bv      — Max BV cap per matching cycle        (default: 50)
//   matching.income_per_bv       — USD payout per BV unit matched       (default: 5)
//   matching.min_referrals       — Minimum direct referrals to qualify  (default: 2)

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// ── Level Income ──────────────────────────────────────────────────────────────
//
// Created inline when an investment is made — one record per ancestor level
// that receives a payout (up to 5 levels up the sponsor chain).
//
//   receiverUserId   = sponsor ancestor who receives the income
//   sourceUserId     = investor whose investment triggered the payout
//   level            = 1 (direct sponsor) through 5
//   investmentAmount = gross investment amount used as the percentage base
//   percentage       = percentage applied (stored as 1 = 1%, 2 = 2%, etc.)
//   incomeAmount     = investmentAmount × (percentage / 100)
//   — credited to receiverUser.withdrawalWallet

model LevelIncome {
  id               String   @id @default(cuid())
  receiverUserId   String
  sourceUserId     String
  level            Int
  investmentId     String
  investmentAmount Decimal  @db.Decimal(18, 8)
  percentage       Decimal  @db.Decimal(6, 4)
  incomeAmount     Decimal  @db.Decimal(18, 8)
  createdAt        DateTime @default(now())

  receiver   User       @relation("LevelIncomeReceiver", fields: [receiverUserId], references: [id], onDelete: Restrict)
  source     User       @relation("LevelIncomeSource",   fields: [sourceUserId],   references: [id], onDelete: Restrict)
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Restrict)

  @@index([receiverUserId])
  @@index([sourceUserId])
  @@index([investmentId])
  @@index([level])
  @@index([createdAt])
  @@map("level_income")
}

// ── Salary Rank Configuration ─────────────────────────────────────────────────
//
// Seeded once; updated by admins. Controls qualification thresholds and payouts.
//
//   requiresDualDirects  = must have ≥1 personally-sponsored member on each leg
//   allowSpill           = spill BV counts toward requiredBusiness
//   powerLegRequired     = minimum BV the weaker leg must hold (Platinum+)
//   weakLegRequired      = minimum BV the stronger leg must hold (Platinum+)

model SalaryRankConfig {
  id               String   @id @default(cuid())
  rankName         String   @unique
  requiredBusiness Decimal  @db.Decimal(18, 2)
  monthlySalary    Decimal  @db.Decimal(18, 2)
  durationMonths   Int
  requiresDualDirects Boolean @default(false)
  allowSpill          Boolean @default(false)
  powerLegRequired  Decimal?                 @db.Decimal(18, 2)
  weakLegRequired   Decimal?                 @db.Decimal(18, 2)
  isActive          Boolean                  @default(true)
  qualificationPool SalaryQualificationPool  @default(DIRECT_ONLY)
  createdAt         DateTime                 @default(now())

  achievements SalaryAchievement[]

  @@map("salary_rank_config")
}

// ── Salary Achievement ────────────────────────────────────────────────────────
//
// Cumulative Milestone Model (Sprint 23F):
//   • One record per user per rank — created once when the rank is first earned.
//   • A member may hold multiple ACTIVE achievements simultaneously
//     (Bronze + Silver + Gold are all valid at the same time).
//   • Earning a higher rank NEVER deactivates lower-rank achievements.
//   • isActive → false when paymentsMade reaches durationMonths, or expiresAt passes.
//
// Payment tracking:
//   paymentsMade  — incremented by the salary cron after each successful payment
//   lastPaidAt    — timestamp of the most recent payment (set by the cron)

model SalaryAchievement {
  id            String    @id @default(cuid())
  userId        String
  rankName      String
  achievedAt    DateTime  @default(now())
  expiresAt     DateTime
  monthlyAmount Decimal   @db.Decimal(18, 2)
  isActive      Boolean   @default(true)
  paymentsMade  Int       @default(0)
  lastPaidAt    DateTime?
  createdAt     DateTime  @default(now())

  user   User             @relation(fields: [userId],   references: [id], onDelete: Restrict)
  config SalaryRankConfig @relation(fields: [rankName], references: [rankName], onDelete: Restrict)

  @@unique([userId, rankName])
  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("salary_achievement")
}

// ── Salary Income ─────────────────────────────────────────────────────────────
//
// One record per user per rank per month.
// Idempotency key: (userId, month, year) — one salary per member per month.
// Sprint 33H: status + reference added; unique constraint narrowed to (userId, month, year)
// so the engine generates exactly one salary per member per calendar month,
// regardless of which rank was selected.

model SalaryIncome {
  id            String             @id @default(cuid())
  userId        String
  rankName      String
  month         Int
  year          Int
  amount        Decimal            @db.Decimal(18, 2)
  status        SalaryIncomeStatus @default(PENDING)
  reference     String?
  // Approval fields — set by approveSalary()
  approvedAt    DateTime?
  approvedBy    String?
  // Payout fields — set by paySalary()
  paidAt        DateTime?
  transactionId String?            // WalletTransaction.id after successful payout
  // Run association — nullable for records created before SalaryRun was introduced
  salaryRunId   String?
  createdAt     DateTime           @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  payoutEvents SalaryPayoutEvent[]
  run          SalaryRun?          @relation(fields: [salaryRunId], references: [id], onDelete: SetNull)

  @@unique([userId, month, year])
  @@index([userId])
  @@index([year, month])
  @@index([status])
  @@index([salaryRunId])
  @@index([createdAt])
  @@map("salary_income")
}

// ── Salary Payout Event ───────────────────────────────────────────────────────
//
// Immutable audit trail for every salary status transition (APPROVED, PAID).
// One record is inserted per transition. Never updated or deleted.

model SalaryPayoutEvent {
  id             String                @id @default(cuid())
  salaryIncomeId String
  userId         String
  eventType      SalaryPayoutEventType
  performedBy    String?
  metadata       Json?
  createdAt      DateTime              @default(now())

  income SalaryIncome @relation(fields: [salaryIncomeId], references: [id], onDelete: Restrict)
  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([salaryIncomeId])
  @@index([userId])
  @@index([eventType])
  @@map("salary_payout_event")
}

// ── Salary Run ────────────────────────────────────────────────────────────────
//
// Managed financial event representing one monthly payroll cycle.
// Created once per (month, year).  Tracks aggregate counters so Finance
// never has to run expensive COUNTs during normal operation.
//
// Lifecycle:  GENERATING → GENERATED → APPROVING → APPROVED → PAYING → COMPLETED
//             Any stage can transition to FAILED via markRunFailed().

model SalaryRun {
  id             String          @id @default(cuid())
  month          Int
  year           Int
  status         SalaryRunStatus @default(GENERATING)
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  generatedCount Int             @default(0)
  approvedCount  Int             @default(0)
  paidCount      Int             @default(0)
  failedCount    Int             @default(0)
  totalAmount    Decimal         @default(0) @db.Decimal(18, 2)
  createdBy      String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  incomes SalaryIncome[]
  audits  SalaryRunAudit[]

  @@unique([month, year])
  @@index([status])
  @@index([year, month])
  @@map("salary_run")
}

// ── Salary Run Audit ──────────────────────────────────────────────────────────
//
// Immutable audit trail for every SalaryRun state transition.
// Never updated or deleted.

model SalaryRunAudit {
  id          String               @id @default(cuid())
  salaryRunId String
  action      SalaryRunAuditAction
  performedBy String?
  metadata    Json?
  createdAt   DateTime             @default(now())

  run SalaryRun @relation(fields: [salaryRunId], references: [id], onDelete: Restrict)

  @@index([salaryRunId])
  @@index([action])
  @@map("salary_run_audit")
}

// ── Salary Business Summary ───────────────────────────────────────────────────
//
// 1-to-1 with User. Single source of truth for salary qualification counters.
// Pattern mirrors the Wallet table — financial domain data lives in its own
// table, not as columns on User.
//
// Counters are updated atomically via Prisma `increment` operators.
// version is bumped on every write for optimistic-concurrency detection.
// lastReconciledAt is set by the nightly drift-reconciliation cron.

model SalaryBusinessSummary {
  id               String    @id @default(cuid())
  userId           String    @unique
  directBusiness   Decimal   @default(0) @db.Decimal(18, 8)
  downlineBusiness Decimal   @default(0) @db.Decimal(18, 8)
  powerBusiness    Decimal   @default(0) @db.Decimal(18, 8)
  lastReconciledAt DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("salary_business_summary")
}

// ── Salary Business Event ─────────────────────────────────────────────────────
//
// Immutable audit trail for every salary pool delta.
// NEVER update. NEVER delete.
// Unique constraint (userId, pool, referenceId, eventType) ensures idempotency:
// replaying an investment event cannot double-count a pool credit.

model SalaryBusinessEvent {
  id            String          @id @default(cuid())
  userId        String
  sourceUserId  String?
  pool          SalaryPool
  eventType     SalaryEventType
  delta         Decimal         @db.Decimal(18, 8)
  referenceId   String
  referenceType String
  depth         Int?
  metadata      Json?
  createdAt     DateTime        @default(now())

  user       User  @relation("SalaryBusinessEventUser",   fields: [userId],       references: [id], onDelete: Restrict)
  sourceUser User? @relation("SalaryBusinessEventSource", fields: [sourceUserId], references: [id], onDelete: Restrict)

  @@unique([userId, pool, referenceId, eventType])
  @@index([userId])
  @@index([sourceUserId])
  @@index([referenceId])
  @@index([createdAt])
  @@map("salary_business_event")
}

// ── Company Wallets ───────────────────────────────────────────────────────────
//
// Managed by admins. Shown to users during deposit submission so they know
// which on-chain address to send funds to for each network.

model CompanyWallet {
  id            String         @id @default(cuid())
  network       DepositNetwork
  walletAddress String
  qrObjectPath  String         @default("/legacy/deposit-wallet-qr")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  // Keep the database-level insert default created by the existing
  // company-wallet migration; @updatedAt still refreshes it on updates.
  updatedAt     DateTime       @default(now()) @updatedAt

  @@unique([network, walletAddress])
  @@index([network])
  @@index([isActive])
  @@map("company_wallets")
}

// ── Deposit Requests ──────────────────────────────────────────────────────────
//
// Submitted by users after sending crypto manually.
// Admin approves → credit depositWallet; or rejects with a reason.
//
//   minimumDeposit   = (approvedDepositCount + 1) × 100
//   amount           = must be a multiple of $100, ≥ minimumDeposit
//   txHash           = on-chain transaction hash (unique)
//   companyWallet    = address the user was shown / sent funds to
//   screenshotUrl    = optional proof of payment screenshot

model DepositRequest {
  id               String         @id @default(cuid())
  userId           String
  amount           Decimal        @db.Decimal(18, 2)
  network          DepositNetwork
  txHash           String         @unique
  screenshotUrl    String?
  companyWallet    String
  status           DepositStatus  @default(PENDING)
  approvedByAdminId String?
  approvedAt       DateTime?
  rejectedReason   String?
  createdAt        DateTime       @default(now())

  user         User                @relation(fields: [userId],            references: [id], onDelete: Restrict)
  approver     Admin?              @relation(fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  verification DepositVerification?

  @@index([userId])
  @@index([status])
  @@index([network])
  @@index([txHash])
  @@index([createdAt])
  @@map("deposit_requests")
}

// ── Manual Deposit Idempotency ────────────────────────────────────────────────
//
// One committed record per admin/key pair. This record is created in the same
// transaction as the manual deposit so a duplicate request cannot credit the
// wallet without also hitting the unique idempotency constraint.
model ManualDepositIdempotency {
  id                 String         @id @default(cuid())
  adminId            String
  idempotencyKey     String
  requestFingerprint String
  depositId          String         @unique
  userId             String
  username           String
  amount             Decimal        @db.Decimal(18, 2)
  network            DepositNetwork
  reason             String
  creditedAt         DateTime
  createdAt          DateTime       @default(now())

  @@unique([adminId, idempotencyKey])
  @@index([adminId])
  @@index([userId])
  @@map("manual_deposit_idempotency")
}

// ── Withdrawal Settings ───────────────────────────────────────────────────────
//
// One row per network; configurable via DB without a code deploy.
// Seeded with BEP20 defaults: min=$10, max=$2500, enabled=true.

model WithdrawalSettings {
  id            String            @id @default(cuid())
  network       WithdrawalNetwork @unique
  minimumAmount Decimal           @db.Decimal(18, 8)
  maximumAmount Decimal           @db.Decimal(18, 8)
  feePercentage Decimal           @default(0) @db.Decimal(5, 4)
  isEnabled     Boolean           @default(true)
  updatedAt     DateTime          @updatedAt

  @@map("withdrawal_settings")
}

// ── Withdrawal Requests ───────────────────────────────────────────────────────
//
// User submits a request to withdraw from withdrawalWallet.
// Funds are locked immediately (wallets.lockedWithdrawalBalance += amount,
//   wallets.withdrawalWallet -= amount).
//
// Flow:  PENDING → VALIDATING → QUEUED → PROCESSING → BROADCASTING → CONFIRMING → COMPLETED
//        PENDING → CANCELLED  (user-initiated, auto-refund)
//        PENDING/APPROVED → REJECTED  (admin, auto-refund)
//        Any pre-COMPLETED state → FAILED (system, auto-refund)
//        APPROVED (legacy admin-approve) → COMPLETED (txHash required)

model WithdrawalRequest {
  id                      String            @id @default(cuid())
  seqId                   Int               @default(autoincrement())
  withdrawalId            String?           @unique
  idempotencyKey          String            @unique @default(uuid())
  userId                  String
  currency                String            @default("USDT")
  amount                  Decimal           @db.Decimal(18, 8)
  fee                     Decimal           @default(0) @db.Decimal(18, 8)
  netAmount               Decimal           @db.Decimal(18, 8)
  walletAddress           String
  walletAddressSnapshot   String
  network                 WithdrawalNetwork
  status                  WithdrawalStatus  @default(PENDING)
  claimOwner              String?
  claimToken              String?           @unique
  claimExpiresAt          DateTime?
  approvedByAdminId       String?
  completedByAdminId      String?
  txHash                  String?           @unique
  failureReason           String?
  broadcastUnknownAt      DateTime?
  broadcastUnknownReason  String?
  rejectedReason          String?
  adminNotes              String?
  preparedTxData          Json?
  broadcastAt             DateTime?
  signedAt                DateTime?
  requestedAt             DateTime          @default(now())
  processedAt             DateTime?
  cancelledAt             DateTime?
  approvedAt              DateTime?
  completedAt             DateTime?
  confirmationBlock       Int?
  confirmationCount       Int?
  explorerUrl             String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user      User   @relation(fields: [userId],             references: [id], onDelete: Restrict)
  approver  Admin? @relation("WithdrawalApprover",  fields: [approvedByAdminId],  references: [id], onDelete: SetNull)
  completer Admin? @relation("WithdrawalCompleter", fields: [completedByAdminId], references: [id], onDelete: SetNull)
  events    WithdrawalEvent[]
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([status])
  @@index([network])
  @@index([createdAt])
  @@index([status, claimExpiresAt])
  @@index([claimOwner, claimExpiresAt])
  @@map("withdrawal_requests")
}

// ── Withdrawal Event Log ───────────────────────────────────────────────────────
//
// Append-only timeline of state transitions and notable events for each
// withdrawal request.  Used by admin UI to show a full audit trail.
//
// eventType examples: CREATED, VALIDATED, QUEUED, PROCESSING, SIGNED,
//   BROADCAST, CONFIRMING, CONFIRMED, COMPLETED, FAILED, REFUNDED,
//   MANUAL_REVIEW, RECOVERY_SCAN, CONFIRMATION_POLL

model WithdrawalEvent {
  id           String   @id @default(cuid())
  withdrawalId String
  eventType    String
  details      Json?
  createdAt    DateTime @default(now())

  withdrawal WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId])
  @@index([createdAt])
  @@map("withdrawal_events")
}

model WalletAddress {
  id         String            @id @default(cuid())
  userId     String
  network    WithdrawalNetwork
  address    String
  label      String?
  isVerified Boolean           @default(true)
  isPrimary  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, network, address])
  @@index([userId])
  @@index([network])
