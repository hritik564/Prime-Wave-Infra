modules = ["nodejs-20", "web", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
MIN_HOT_WALLET_BNB = "0.0015"

[userenv.development]

[userenv.shared]
BLOCKCHAIN_DRY_RUN = "false"

[objectStorage]
defaultBucketID = "replit-objstore-c49ce2b1-feb8-40b5-abd6-6db368d836fa"
